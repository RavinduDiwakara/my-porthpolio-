<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 840" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0f1d" />
      <stop offset="50%" stop-color="#111827" />
      <stop offset="100%" stop-color="#030712" />
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.8" />
      <stop offset="50%" stop-color="#64748b" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.8" />
    </linearGradient>
    <radialGradient id="sealGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.05" />
    </radialGradient>
  </defs>

  <!-- Background Canvas -->
  <rect width="1200" height="840" rx="20" fill="url(#bgGrad)" />

  <!-- Outer Tech Geometric Border -->
  <rect x="25" y="25" width="1150" height="790" rx="16" fill="none" stroke="url(#borderGrad)" stroke-width="2" />
  <rect x="35" y="35" width="1130" height="770" rx="12" fill="none" stroke="#1f2937" stroke-width="1" stroke-dasharray="8 6" />

  <!-- Corner Tech Brackets -->
  <path d="M 25 65 L 25 25 L 65 25" fill="none" stroke="#06b6d4" stroke-width="4" />
  <path d="M 1175 65 L 1175 25 L 1135 25" fill="none" stroke="#06b6d4" stroke-width="4" />
  <path d="M 25 775 L 25 815 L 65 815" fill="none" stroke="#06b6d4" stroke-width="4" />
  <path d="M 1175 775 L 1175 815 L 1135 815" fill="none" stroke="#06b6d4" stroke-width="4" />

  <!-- Seal Emblem -->
  <circle cx="600" cy="620" r="64" fill="url(#sealGrad)" stroke="#06b6d4" stroke-width="2" stroke-dasharray="6 4" />
  <circle cx="600" cy="620" r="50" fill="none" stroke="#06b6d4" stroke-width="1.5" />
  <text x="600" y="626" font-family="monospace" font-size="12" font-weight="bold" fill="#06b6d4" text-anchor="middle" letter-spacing="3">VERIFIED CREDENTIAL</text>

  <!-- Header Brand -->
  <text x="600" y="110" font-family="monospace" font-size="14" font-weight="600" fill="#06b6d4" text-anchor="middle" letter-spacing="6">CERTIFICATE OF ACHIEVEMENT</text>
  <text x="600" y="145" font-family="sans-serif" font-size="15" fill="#94a3b8" text-anchor="middle" letter-spacing="2">CISCO SYSTEMS / LEARNING NETWORK</text>

  <!-- Horizontal divider line -->
  <line x1="450" y1="175" x2="750" y2="175" stroke="#06b6d4" stroke-width="2" stroke-opacity="0.7" />

  <!-- Certificate Presented To -->
  <text x="600" y="240" font-family="sans-serif" font-size="14" fill="#64748b" text-anchor="middle" letter-spacing="2">THIS IS PROUDLY PRESENTED TO</text>
  <text x="600" y="305" font-family="sans-serif" font-size="38" font-weight="bold" fill="#f8fafc" text-anchor="middle" letter-spacing="1">H.U.G. Ravindu Diwakara</text>

  <!-- Description of Merit -->
  <text x="600" y="360" font-family="sans-serif" font-size="15" fill="#94a3b8" text-anchor="middle">for successfully completing the rigorous curriculum and practical requirements for</text>

  <!-- Course Title -->
  <rect x="200" y="395" width="800" height="75" rx="12" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
  <text x="600" y="442" font-family="sans-serif" font-size="25" font-weight="700" fill="#38bdf8" text-anchor="middle">Network Fundamentals Specialization</text>

  <!-- Badge Details -->
  <text x="600" y="515" font-family="sans-serif" font-size="15" fill="#cbd5e1" text-anchor="middle">Program Track: <tspan font-weight="600" fill="#f1f5f9">Cisco Certified Network Track</tspan></text>

  <!-- Bottom Verification Footer -->
  <g transform="translate(100, 720)">
    <text x="0" y="0" font-family="monospace" font-size="12" fill="#64748b">DATE OF ISSUANCE</text>
    <text x="0" y="24" font-family="sans-serif" font-size="15" font-weight="600" fill="#f8fafc">2024 - 2026</text>
    <line x1="0" y1="36" x2="220" y2="36" stroke="#334155" stroke-width="1" />
  </g>

  <g transform="translate(900, 720)">
    <text x="200" y="0" font-family="monospace" font-size="12" fill="#64748b" text-anchor="end">CREDENTIAL ID</text>
    <text x="200" y="24" font-family="monospace" font-size="14" font-weight="600" fill="#06b6d4" text-anchor="end">CSCO-NET-2024-8192</text>
    <line x1="-20" y1="36" x2="200" y2="36" stroke="#334155" stroke-width="1" />
  </g>
</svg>